# Copy to .env and fill in from your Supabase project settings (API section).
# Only needed for accounts and level sharing — the designer, campaign and eval
# pages work without it, using the API keys you add in the app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
